# Shared repository scope: only the application and its documentation belong here.
/*
!/.gitignore
!/README.md
!/.github/
!/.github/**
!/backend/
!/backend/**
!/frontend/
!/frontend/**
!/classifier-service/
!/classifier-service/**

# Local secrets and environment files
**/.env
**/.env.*
!**/.env.example

# Python backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/storage/
backend/.pytest_cache/

# Classifier service (model weights are large local artifacts, never commit them)
classifier-service/__pycache__/
classifier-service/**/__pycache__/
classifier-service/*.py[cod]
classifier-service/.pytest_cache/
classifier-service/model_out/
classifier-service/model_out_v1_backup/
classifier-service/model_out_*_backup/
classifier-service/dummy_model/
classifier-service/*.pt
classifier-service/*.safetensors
classifier-service/.venv/

# Frontend
frontend/**/node_modules/
frontend/**/dist/
frontend/**/.vite/
frontend/**/*.tsbuildinfo
frontend/**/.git-frontend-history-backup/

# Local databases, logs, and editor files
*.db
*.sqlite
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db
