APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/passbox_db
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ACCESS_TOKEN_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=storage
GATEWAY_MODE=LIVE
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLASSIFIER_MODE=LOCAL_RULES
CLASSIFIER_SERVICE_URL=
CLASSIFIER_SERVICE_TOKEN=
CLASSIFIER_TIMEOUT_SECONDS=10
CLASSIFIER_MODEL=passbox-classifier-v0
CLASSIFIER_POLICY_VERSION=LOCAL-TEMPLATE-v1
JOB_WORKER_THREADS=1
