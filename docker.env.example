# docker compose 용 설정. 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올리지 않습니다)

# DB 비밀번호 (자유롭게 길게)
POSTGRES_PASSWORD=

# 로그인 토큰 서명 키 (긴 무작위 문자열)
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# 저장 본문 암호화 키 (32자 이상, 잃어버리면 저장된 본문을 복호화할 수 없음)
DATA_ENCRYPTION_KEY=

# 백엔드 <-> 분류기 사이 인증 토큰 (아무 긴 문자열, 양쪽에 자동으로 같은 값이 들어감)
CLASSIFIER_TOKEN=

# 외부 AI: 기본은 MOCK(외부 호출 없음). 실제 호출은 LIVE 로 바꾸고 쓸 서비스 키만 넣으세요.
GATEWAY_MODE=MOCK
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ClamAV: required(운영 권장, 백신 연결 안 되면 업로드 거부) / optional / off
CLAMAV_MODE=required

# 로그인 화면이 사용할 기관 ID (비워 두면 프런트 기본값을 씁니다. DB 에서 만든 기관 ID 확인 후 입력)
VITE_TENANT_ID=
